# ─── Solana Configuration ────────────────────────────────────────────────────
# Public RPC endpoint for Solana Devnet (default used if not set)
NEXT_PUBLIC_SOLANA_RPC_URL=https://api.devnet.solana.com

# Deployed Anchor program ID on Solana Devnet
# Replace with your deployed program address from Solana Playground
NEXT_PUBLIC_TOURISM_PROGRAM_ID=A7yU8i4YBUmnR5fZUxxC88ytFe59XkZGvqN1tj34VSzN

# ─── Server-side RPC (not exposed to browser) ────────────────────────────────
# Used for on-chain agent identity verification in API routes
SOLANA_RPC_URL=https://api.devnet.solana.com

# ─── Optional: AI Itinerary Generation ────────────────────────────────────────
# If set, the /api/planner route uses GPT-4o-mini for AI-generated itineraries.
# If not set, a high-quality static itinerary database is used (no API needed).
# Keep this server-side only — never prefix with NEXT_PUBLIC_
OPENAI_API_KEY=

# ─── Notes ────────────────────────────────────────────────────────────────────
# - Copy this file to .env.local and fill in your values
# - Never commit .env.local or wallet keypairs to git
# - The app works without OPENAI_API_KEY using the built-in static itineraries
# - NEXT_PUBLIC_ variables are exposed to the browser — never put secrets there
